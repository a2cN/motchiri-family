{
  "name": "motchiri-family",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/supabase-env.mjs -- next dev",
    "build": "node scripts/supabase-env.mjs -- next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "supabase db reset --local && npm run build && playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.playwright-browsers\" playwright install webkit",
    "secrets:scan": "gitleaks dir --redact --config .gitleaks.toml .",
    "contrast": "node scripts/contrast.mjs",
    "pwa-images": "node scripts/pwa-images.mjs",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db && supabase db advisors --local --type security --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "check:client-secrets": "node scripts/supabase-env.mjs -- node scripts/check-client-secrets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.56.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "shadcn": "4.21.4",
    "stylelint": "^17.16.0",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
